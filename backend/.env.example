# ---------------------------------------------------------------------------
# Environment variables for the Django backend.
#
# Copy this file to `.env` (in the `backend/` directory) and edit the values.
# `.env` is gitignored — never commit it. Every variable below is OPTIONAL:
# settings.py has a working development default for each one, so `runserver`
# works with no `.env` at all.
#
# Values already present in the real process environment always win over this
# file, so a container/PaaS deployment can ignore `.env` entirely.
# ---------------------------------------------------------------------------

# --- Core -------------------------------------------------------------------

# REQUIRED in production. Any value; must not start with "django-insecure-".
# Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
# settings.py REFUSES to start with the insecure default when DEBUG is off.
DJANGO_SECRET_KEY=

# "true" / "false". Defaults to true. MUST be false in production.
DJANGO_DEBUG=true

# Comma separated, no spaces needed. Defaults to localhost,127.0.0.1.
# In production list the host(s) that serve the API, e.g.
#   DJANGO_ALLOWED_HOSTS=booking-api.example.com,www.booking-api.example.com
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database ---------------------------------------------------------------

# Optional. When unset the project uses local SQLite at backend/db.sqlite3.
# PostgreSQL is the intended production database:
#   DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME
# sqlite:// is also accepted, e.g. sqlite:///db.sqlite3
# DATABASE_URL=

# --- CORS / CSRF ------------------------------------------------------------

# Comma separated origins allowed to call the API cross-origin.
# Defaults to http://localhost:4200 and http://127.0.0.1:4200.
# Only needed if the browser talks to Django directly; not needed when the
# frontend proxies /api (Angular dev server, or the Vercel rewrite).
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

# Comma separated https origins trusted for Django admin CSRF. Empty by default.
# CSRF_TRUSTED_ORIGINS=https://admin.example.com

# --- Throttling (public, unauthenticated endpoints) -------------------------

# Per-IP limits for the /api/public/... endpoints. Disabled automatically while
# the test suite runs.
THROTTLE_PUBLIC_ORGANIZATION=120/min
THROTTLE_PUBLIC_AVAILABILITY=60/min

# --- JWT --------------------------------------------------------------------

# SimpleJWT defaults are 5 minutes / 1 day; these only need setting to change them.
JWT_ACCESS_TOKEN_MINUTES=5
JWT_REFRESH_TOKEN_DAYS=1
